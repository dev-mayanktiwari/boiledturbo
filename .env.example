# Copy to `.env` at the repo root and fill in real values. `.env` is gitignored.
# On EC2, real values come from the environment (Compose env_file / secrets) and take
# precedence over this file.

# ---- Server (Node only) ----
NODE_ENV=development
PORT=4000
# PostgreSQL connection string. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# ---- Web (Next.js). NEXT_PUBLIC_* values are baked in at build time. ----
NEXT_PUBLIC_API_URL="http://localhost:4000"
